{
  "name": "dev-machine",
  "version": "0.1.0",
  "description": "One-command multi-project local dev environment with TUI dashboard",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "dev-machine": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "tui": "tsx src/tui/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "local-dev",
    "docker",
    "tui",
    "terminal-ui",
    "developer-tools",
    "docker-compose",
    "caddy",
    "mkcert"
  ],
  "author": "Jekabs Porietis <jekabsporietis@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jecis-repos/dev-machine"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "blessed": "^0.1.81",
    "blessed-contrib": "^4.11.0",
    "chalk": "^5.3.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "tsx": "^4.15.0",
    "vitest": "^2.0.0",
    "@types/node": "^20.14.0",
    "@types/blessed": "^0.1.25"
  }
}
