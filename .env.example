# dev-machine configuration
# Copy to .env and adjust as needed. All values have sensible defaults.

# Base directory for all instances and infrastructure files.
# Defaults to the project root.
# DEVMACHINE_BASE_DIR=/opt/dev-machine

# Domain suffix for instance URLs (e.g. feature-x.app.test)
# DEVMACHINE_DOMAIN_SUFFIX=app.test

# Project subdirectory inside each instance dir (where your app code lives)
# DEVMACHINE_PROJECT_SUBDIR=app

# Default PHP image when composer.json doesn't specify one
# DEVMACHINE_PHP_IMAGE=php:8.4-fpm

# Docker network name shared by all services
# DEVMACHINE_NETWORK=devmachine

# Docker Compose project name (used for container name prefixes)
# DEVMACHINE_COMPOSE_PROJECT=devmachine

# Maximum number of instances
# DEVMACHINE_MAX_INSTANCES=20

# Disable automatic /etc/hosts updates
# DEVMACHINE_DISABLE_HOSTS_UPDATE=true

# Let Caddy manage TLS via ACME (instead of mkcert)
# DEVMACHINE_CADDY_MANAGED_TLS=true

# Custom TLS certificate paths (host-side)
# DEVMACHINE_CERT_PATH=_docker/caddy/certs/app.test+1.pem
# DEVMACHINE_CERT_KEY_PATH=_docker/caddy/certs/app.test+1-key.pem

# Backup root directory
# DEVMACHINE_BACKUP_ROOT=/opt/dev-machine/backups

# GitHub token for private repo cloning
# DEVMACHINE_GITHUB_TOKEN=ghp_...

# GitHub org/user and repo (for branch listing, PR creation)
# DEVMACHINE_GITHUB_OWNER=your-org
# DEVMACHINE_GITHUB_REPO=your-repo
